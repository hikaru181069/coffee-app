# direnv の設定。このフォルダに入ると flake.nix の開発環境（Node.js 22 / Python 3.13 など）が有効になる
# 初回だけ `direnv allow` が必要
use flake

# fastapi-service 用の Python の仮想環境（pyrightconfig.json も .venv を見る）
# なければ作り、requirements が前回のインストールより新しければ入れ直す
if [[ ! -x .venv/bin/python ]]; then
  uv venv --python "$(command -v python3)" .venv
fi
if [[ ! -e .venv/.installed \
  || fastapi-service/requirements.txt -nt .venv/.installed \
  || fastapi-service/requirements-dev.txt -nt .venv/.installed ]]; then
  uv pip install --python .venv/bin/python -r fastapi-service/requirements-dev.txt && touch .venv/.installed
fi
export VIRTUAL_ENV="$PWD/.venv"
PATH_add .venv/bin

# requirements が変わったら、このファイルを読み直す
watch_file fastapi-service/requirements.txt fastapi-service/requirements-dev.txt
