# docker-compose.prod.yml（本番相当の動き方をローカルで再現する用）が
# 読み込む環境変数のひな形。
#
# 使い方:
#   1. このファイルを .env.prod としてコピーする（.env.prodはgitignore済み、
#      絶対にコミットしない）
#   2. JWT_SECRETを、推測されにくいランダムな文字列に書き換える
#      （生成例: `openssl rand -base64 32`）
#   3. docker compose -f docker-compose.prod.yml --env-file .env.prod up --build

JWT_SECRET=
