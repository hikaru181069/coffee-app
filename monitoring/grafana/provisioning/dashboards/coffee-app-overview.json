{
  "uid": "coffee-app-overview",
  "title": "Coffee App Overview",
  "tags": ["coffee-app"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Targets Up",
      "description": "backend・fastapiのPrometheusスクレイピングが成功しているか（1=UP, 0=DOWN）",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"backend|fastapi\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": { "0": { "text": "DOWN", "color": "red" } }
            },
            {
              "type": "value",
              "options": { "1": { "text": "UP", "color": "green" } }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request Rate",
      "description": "サービスごとの秒間リクエスト数（http_request_duration_seconds_countの増加率。backend・fastapiで同じメトリクス名を使っているため1つのクエリで両方見える）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_request_duration_seconds_count[5m]))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 Latency",
      "description": "サービスごとのリクエスト所要時間（95パーセンタイル）",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Backend Memory",
      "description": "backendプロセスのメモリ使用量。RSS=OSから見た実際の使用量、Heap Total=V8が確保しているヒープ容量、Heap Used=実際に使用中のヒープ",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"backend\"}",
          "legendFormat": "RSS"
        },
        {
          "refId": "B",
          "expr": "nodejs_heap_size_total_bytes{job=\"backend\"}",
          "legendFormat": "Heap Total"
        },
        {
          "refId": "C",
          "expr": "nodejs_heap_size_used_bytes{job=\"backend\"}",
          "legendFormat": "Heap Used"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      }
    }
  ]
}
