# backend/.env のひな形。値を埋めて backend/.env として保存する。
# Docker Compose で起動する場合は docker-compose.yml 側で同じ変数を渡すため、
# このファイルを用意する必要はない。

# Express が待ち受けるポート
PORT=5001

# MongoDB 接続先。ローカルは docker compose up -d mongodb で起動したものを使う
MONGO_URI=mongodb://127.0.0.1:27017/coffeeApp

# JWT の署名鍵。本番では十分に長いランダム文字列にし、絶対にコミットしない
JWT_SECRET=your_jwt_secret

# CORS で許可するフロントエンドのURL（http://localhost:5173 は常に許可される）
FRONTEND_URL=http://localhost:5173

# 計算処理を委譲する FastAPI サービスのURL
FASTAPI_URL=http://localhost:8000
